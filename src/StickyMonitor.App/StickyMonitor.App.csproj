<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>..\..\assets\app-icon.ico</ApplicationIcon>
    <AssemblyName>StickyMonitor.App</AssemblyName>
    <RootNamespace>StickyMonitor.App</RootNamespace>
    <StartupObject>StickyMonitor.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <AssemblyTitle>Sticky Monitor</AssemblyTitle>
    <Product>Sticky Monitor</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Content Include="..\..\assets\app-icon.ico" Link="app-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <PackageReference Include="System.Management" Version="10.0.5" />
  </ItemGroup>

</Project>
