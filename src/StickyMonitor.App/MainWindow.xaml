<Window x:Class="StickyMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sticky Monitor"
        Width="1160"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Text="Sticky Monitor"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Text="{Binding StickyModeLabel}"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <ToggleButton IsChecked="{Binding IsStickyModeEnabled, Mode=TwoWay}"
                                  Style="{StaticResource PillToggleStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Monitor Layout"
                                   Style="{StaticResource HeaderTextStyle}"
                                   FontSize="18" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="Select a monitor to manage its sticky behavior."
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>

                    <Viewbox Grid.Row="1"
                             Margin="0,24,0,0"
                             Stretch="Uniform"
                             StretchDirection="Both">
                        <Canvas Width="{Binding CanvasWidth}"
                                Height="{Binding CanvasHeight}">
                            <ItemsControl ItemsSource="{Binding Monitors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="{Binding Width}"
                                                Height="{Binding Height}"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.SelectMonitorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Card"
                                                            Background="{Binding CardBrush}"
                                                            BorderBrush="{Binding BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="18"
                                                            Padding="14"
                                                            SnapsToDevicePixels="True">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="8"
                                                                              ShadowDepth="0"
                                                                              Opacity="0.06" />
                                                        </Border.Effect>
                                                        <Grid>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSticky}" Value="True">
                                                            <Setter TargetName="Card" Property="BorderThickness" Value="30" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Card" Property="Opacity" Value="0.99" />
                                                            <Setter TargetName="Card" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <TranslateTransform Y="-2" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Card" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <TranslateTransform Y="0" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Viewbox>

                    <Border Grid.Row="3"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="SELECTED MONITOR"
                                       Style="{StaticResource SectionLabelStyle}" />
                            <Border Margin="0,12,0,0"
                                    Background="#101721"
                                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="34"
                                                Height="34"
                                                Background="{Binding SelectedMonitor.StatusBrush}"
                                                CornerRadius="17"
                                                VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe Fluent Icons"
                                                       Text="&#xE718;"
                                                       FontSize="14"
                                                       Foreground="#0B1016" />
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0,0,0">
                                            <TextBlock Text="{Binding SelectedMonitorName}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding SelectedMonitorStateLabel}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <ToggleButton Grid.Column="2"
                                                      Margin="16,0,0,0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding SelectedMonitorPinned, Mode=TwoWay}"
                                                      IsEnabled="{Binding HasSelectedMonitor}"
                                                      Style="{StaticResource PillToggleStyle}" />
                                    </Grid>

                                    <Border Margin="0,14,0,0"
                                            Background="#0E141C"
                                            CornerRadius="12"
                                            Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="Model"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SelectedMonitorMeta}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextWrapping="Wrap" />

                                            <TextBlock Grid.Row="1"
                                                       Margin="0,10,0,0"
                                                       Text="Orientation"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="2"
                                                       Margin="0,10,0,0"
                                                       Text="{Binding SelectedMonitorOrientation}"
                                                       Foreground="{StaticResource TextBrush}" />

                                            <TextBlock Grid.Row="2"
                                                       Margin="0,10,0,0"
                                                       Text="Status"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <StackPanel Grid.Row="2"
                                                        Grid.Column="2"
                                                        Margin="0,10,0,0"
                                                        Orientation="Horizontal">
                                                <Ellipse Width="10"
                                                         Height="10"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding SelectedMonitor.StatusBrush}" />
                                                <TextBlock Text="{Binding SelectedMonitorStateLabel}"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="SYSTEM"
                                       Style="{StaticResource SectionLabelStyle}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Launch at login"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="Starts minimized in the system tray."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               MaxWidth="180" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Margin="16,0,0,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}"
                                              Style="{StaticResource PillToggleStyle}" />
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Instant window detection"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="Detect immediately when a window moves onto or off a sticky monitor."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               MaxWidth="180" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Margin="16,0,0,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsInstantDetectionEnabled, Mode=TwoWay}"
                                              Style="{StaticResource PillToggleStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="MODE"
                                       Style="{StaticResource SectionLabelStyle}" />
                            <Border Margin="0,12,0,0"
                                    Background="#101721"
                                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Content="Manual"
                                                  Grid.Column="0"
                                                  IsChecked="{Binding IsManualMode, Mode=TwoWay}"
                                                  Style="{StaticResource SegmentToggleStyle}" />
                                    <ToggleButton Content="Auto"
                                                  Grid.Column="1"
                                                  IsChecked="{Binding IsAutoModeSelected, Mode=TwoWay}"
                                                  Style="{StaticResource SegmentToggleStyle}" />
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,12,0,0"
                                       Text="{Binding ModeDescription}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,16,0,0">
                                <Border Style="{StaticResource AnimatedPanelStyle}"
                                        Visibility="{Binding IsAutoMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Background check interval"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding AutoModeDetailsDescription}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <ComboBox Width="148"
                                                  Margin="0,12,0,0"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  ItemsSource="{Binding CheckIntervalOptions}"
                                                  SelectedItem="{Binding SelectedCheckInterval, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource AnimatedPanelStyle}"
                                        Visibility="{Binding IsManualMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <Button
                                                Content="{Binding ManualApplyButtonText}"
                                                Command="{Binding ApplySelectedMonitorCommand}"
                                                Tag="{Binding ShowManualApplyFeedback}"
                                                Style="{StaticResource ManualApplyButtonStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusText}"
                   Foreground="{StaticResource MutedTextBrush}"
                   FontSize="13" />
    </Grid>
</Window>
